# ===========================================
# Hermes Bridge Bot - Переменные окружения
# ===========================================
# Скопируйте этот файл в .env и заполните значения

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# --- MAX Messenger ---
MAX_BOT_TOKEN=your_max_bot_token

# --- AI Agent (Hermes) ---
# Провайдер: openrouter | openai | claude | local
HERMES_PROVIDER=openrouter
HERMES_API_KEY=your_api_key
HERMES_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --- Локальный AI (если HERMES_PROVIDER=local) ---
HERMES_LOCAL_URL=http://localhost:11434/v1

# --- Настройки ---
LOG_LEVEL=INFO
DEBUG=false
